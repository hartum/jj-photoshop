datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          Int       @id @default(autoincrement())
  codigo      String    @unique
  nombre      String
  descripcion String    @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  usuarios    Usuario[]

  @@map("roles")
}

model Usuario {
  id                    String              @id @default(uuid())
  nombre                String
  apellidos             String
  email                 String              @unique
  telefono              String?
  passwordHash          String?             @map("password_hash")
  imagen                String?             @db.LongText
  activo                Boolean             @default(true)
  roleId                Int                 @map("role_id")
  role                  Role                @relation(fields: [roleId], references: [id])
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  deletedAt             DateTime?           @map("deleted_at")
  areasAsignadas        UsuarioArea[]
  hotelesAsignados      UsuarioHotel[]
  sesionesComoFotografo SesionFotografica[] @relation("FotografoSesiones")
  sesionesComoCreador   SesionFotografica[] @relation("CreadorSesiones")
  colorAsignado         UsuarioColor?

  @@map("usuarios")
}

model UsuarioColor {
  id        Int      @id @default(autoincrement())
  usuarioId String   @map("usuario_id")
  color     String   @map("color")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId])
  @@map("usuario_color")
}

model Pais {
  id             Int       @id @default(autoincrement())
  codigo         String    @unique
  nombre         String
  codigoTelefono String?   @map("codigo_telefono")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  areas          Area[]

  @@map("paises")
}

model Area {
  id                Int           @id @default(autoincrement())
  paisId            Int           @map("id_pais")
  nombre            String
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")
  pais              Pais          @relation(fields: [paisId], references: [id])
  hoteles           Hotel[]
  usuariosAsignados UsuarioArea[]

  @@map("areas")
}

model Hotel {
  id                Int                 @id @default(autoincrement())
  areaId            Int                 @map("id_area")
  nombre            String              @map("nombre_hotel")
  direccion         String?
  estrellas         Int?
  latitud           Float?
  longitud          Float?
  cadenaHotelera    String?             @map("cadena_hotelera")
  personaContacto   String?             @map("persona_contacto")
  email             String?
  telefono          String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  deletedAt         DateTime?           @map("deleted_at")
  area              Area                @relation(fields: [areaId], references: [id])
  usuariosAsignados UsuarioHotel[]
  sesiones          SesionFotografica[]

  @@map("hoteles")
}

model UsuarioArea {
  id        Int      @id @default(autoincrement())
  usuarioId String   @map("usuario_id")
  areaId    Int      @map("area_id")
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  area    Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, areaId])
  @@map("usuario_area_acceso")
}

model UsuarioHotel {
  id        Int      @id @default(autoincrement())
  usuarioId String   @map("usuario_id")
  hotelId   Int      @map("hotel_id")
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, hotelId])
  @@map("usuario_hotel_acceso")
}

model SesionFotografica {
  id                    Int       @id @default(autoincrement())
  hotelId               Int       @map("hotel_id")
  fotografoId           String?   @map("fotografo_id")
  creadorId             String    @map("creador_id")
  clienteNombre         String    @map("cliente_nombre")
  clienteEmail          String?   @map("cliente_email")
  clienteTelefono       String?   @map("cliente_telefono")
  numeroHabitacion      String?   @map("numero_habitacion")
  numAdultos            Int       @default(1) @map("num_adultos")
  numNinos              Int       @default(0) @map("num_ninos")
  fechaSalida           DateTime? @map("fecha_salida")
  concepto              String?   @map("concepto")
  fechaHoraInicio       DateTime  @map("fecha_hora_inicio")
  estado                String    @default("PROGRAMADA")
  origen                String    @default("MANUAL")
  notas                 String?   @db.Text
  googleCalendarEventId String?   @map("google_calendar_event_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  fotografo Usuario? @relation("FotografoSesiones", fields: [fotografoId], references: [id])
  creador   Usuario  @relation("CreadorSesiones", fields: [creadorId], references: [id])

  @@map("sesiones_fotograficas")
}
