datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          Int       @id @default(autoincrement())
  codigo      String    @unique
  nombre      String
  descripcion String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  usuarios    Usuario[]

  @@map("roles")
}

model Usuario {
  id               String         @id @default(uuid())
  nombre           String
  apellidos        String
  email            String         @unique
  telefono         String?
  passwordHash     String?
  imagen           String?        @db.LongText
  activo           Boolean        @default(true)
  roleId           Int
  role             Role           @relation(fields: [roleId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  areasAsignadas        UsuarioArea[]
  hotelesAsignados      UsuarioHotel[]
  sesionesComoFotografo SesionFotografica[] @relation("FotografoSesiones")
  sesionesComoCreador   SesionFotografica[] @relation("CreadorSesiones")

  @@map("usuarios")
}

model Pais {
  id             Int       @id @default(autoincrement())
  codigo         String    @unique
  nombre         String
  codigoTelefono String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  areas          Area[]

  @@map("paises")
}

model Area {
  id                Int           @id @default(autoincrement())
  paisId            Int           @map("id_pais")
  nombre            String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  pais              Pais          @relation(fields: [paisId], references: [id])
  hoteles           Hotel[]
  usuariosAsignados UsuarioArea[]

  @@map("areas")
}

model Hotel {
  id                Int                 @id @default(autoincrement())
  areaId            Int                 @map("id_area")
  nombre            String              @map("nombre_hotel")
  direccion         String?
  estrellas         Int?
  latitud           Float?
  longitud          Float?
  cadenaHotelera    String?
  personaContacto   String?
  email             String?
  telefono          String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  area              Area                @relation(fields: [areaId], references: [id])
  usuariosAsignados UsuarioHotel[]
  sesiones          SesionFotografica[]

  @@map("hoteles")
}

model UsuarioArea {
  id        Int      @id @default(autoincrement())
  usuarioId String   @map("usuario_id")
  areaId    Int      @map("area_id")
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  area    Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, areaId])
  @@map("usuario_area_acceso")
}

model UsuarioHotel {
  id        Int      @id @default(autoincrement())
  usuarioId String   @map("usuario_id")
  hotelId   Int      @map("hotel_id")
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, hotelId])
  @@map("usuario_hotel_acceso")
}

model SesionFotografica {
  id                    Int       @id @default(autoincrement())
  hotelId               Int       @map("hotel_id")
  fotografoId           String    @map("fotografo_id")
  creadorId             String    @map("creador_id")
  clienteNombre         String    @map("cliente_nombre")
  clienteEmail          String?   @map("cliente_email")
  clienteTelefono       String?   @map("cliente_telefono")
  fechaHoraInicio       DateTime  @map("fecha_hora_inicio")
  fechaHoraFin          DateTime  @map("fecha_hora_fin")
  estado                String    @default("PROGRAMADA")
  origen                String    @default("MANUAL")
  notas                 String?   @db.Text
  googleCalendarEventId String?   @map("google_calendar_event_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  hotel     Hotel   @relation(fields: [hotelId], references: [id])
  fotografo Usuario @relation("FotografoSesiones", fields: [fotografoId], references: [id])
  creador   Usuario @relation("CreadorSesiones", fields: [creadorId], references: [id])

  @@map("sesiones_fotograficas")
}

